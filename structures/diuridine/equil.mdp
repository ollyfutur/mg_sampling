integrator               = md
dt                       = 0.002
nsteps                   = 50000  ;100 ps

nstlog                   = 5000
nstenergy                = 5000

continuation             = no

constraints              = h-bonds

cutoff-scheme            = Verlet
rlist                    = 1.0

coulombtype              = PME
rcoulomb                 = 1.0

vdwtype                  = Cut-off
rvdw                     = 1.0
DispCorr                 = EnerPres

tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 300

pcoupl                   = C-rescale
pcoupltype               = isotropic
tau-p                    = 1.0
compressibility          = 4.5e-5
ref-p                    = 1.0

pbc                      = xyz  
refcoord_scaling         = com

gen_vel                  = yes
gen_temp                 = 300
gen_seed                 = 12081994


LOAD FILE=/leonardo_work/EUHPC_R02_136/Olivier/mg_sampling/ligandexchange/LigandExchange.so

rmsd: RMSD REFERENCE=../ref_subset.pdb TYPE=SIMPLE

mg: GROUP NDX_FILE=../index.ndx NDX_GROUP=MG
op: GROUP NDX_FILE=../index.ndx NDX_GROUP=O_Phosphate
ob: GROUP NDX_FILE=../index.ndx NDX_GROUP=O_Base
ox: GROUP ATOMS=op,ob
ow: GROUP NDX_FILE=../index.ndx NDX_GROUP=O_Water

cv: LIGANDEXCHANGE ...
   GROUPA=mg
   GROUPB=ox
   GROUPC=ow
   SWITCH={COSINUS R_0=0.24 D_0=0.18}
   VAR=_nox,_now
   FUNC=-9.231958*step(Y)*step(0.5-Y)*step(X-0.00001)*(1-cos(Y*pi*4))*(1-cos(X*pi))/4;X=x+0.099148*(1-cos(x*pi));Y=y-0.288048*(1-cos(x*pi));x=1.039661*_nox-1.039661*_now+6;y=1.039661*_nox+1.039661*_now-6
   NLIST
   NL_CUTOFF_AB=1.0
   NL_CUTOFF_AC=1.0
   NL_STRIDE=500
   NESTED
...

#####################################################################
### Biases ##########################################################
#####################################################################

restr: RESTRAINT ARG=rmsd AT=0 KAPPA=500

scaledcv: COMBINE ARG=cv COEFFICIENTS=@replicas:{0.000000000000000000e+00,2.892471286379908468e-01,4.694644526106962479e-01,6.020486484557282525e-01,6.977462066547472919e-01,7.599062318207173705e-01,8.068579480787927416e-01,8.527992817077731935e-01,8.960757793814615457e-01,9.317631424007446483e-01,9.626692532044520689e-01,1.000000000000000000e+00} PERIODIC=NO

bias: BIASVALUE ARG=scaledcv

#####################################################################
### Output ##########################################################
#####################################################################

PRINT ARG=rmsd,restr.bias STRIDE=5000 FILE=rmsd.COLVAR
PRINT ARG=cv,bias.bias STRIDE=5000 FILE=bias.COLVAR


# Plumed file for replica exchange with bias
LOAD FILE=/leonardo_work/EUHPC_R02_136/Olivier/mg_sampling/ligandexchange/LigandExchange.so

rmsd: RMSD REFERENCE=../ref_heavy.pdb TYPE=SIMPLE

mg: GROUP NDX_FILE=../index.ndx NDX_GROUP=MG
op: GROUP NDX_FILE=../index.ndx NDX_GROUP=O_Phosphate
ob: GROUP NDX_FILE=../index.ndx NDX_GROUP=O_Base
ow: GROUP NDX_FILE=../index.ndx NDX_GROUP=O_Water


cvop: LIGANDEXCHANGE ...
   GROUPA=mg
   GROUPB=op
   GROUPC=ow,ob
   SWITCH={COSINUS R_0=0.24 D_0=0.18}
   VAR=_nop,_nox
   FUNC=-9.231958*step(Y)*step(0.5-Y)*step(X-0.00001)*(1-cos(Y*pi*4))*(1-cos(X*pi))/4;X=x+0.099148*(1-cos(x*pi));Y=y-0.288048*(1-cos(x*pi));x=1.039661*_nop-1.039661*_nox+6;y=1.039661*_nop+1.039661*_nox-6
   NLIST
   NL_CUTOFF_AB=1.0
   NL_CUTOFF_AC=1.0
   NL_STRIDE=500
   NESTED
   COMPONENTS
...


cvob: LIGANDEXCHANGE ...
   GROUPA=mg
   GROUPB=ob
   GROUPC=ow,op
   SWITCH={COSINUS R_0=0.24 D_0=0.18}
   VAR=_nob,_nox
   FUNC=-8.90321*step(Y)*step(0.5-Y)*step(X-0.00001)*(1-cos(Y*pi*4))*(1-cos(X*pi))/4;X=x+-0.023241*(1-cos(x*pi));Y=y-0.215138*(1-cos(x*pi));x=1.039661*_nob-1.039661*_nox+6;y=1.039661*_nob+1.039661*_nox-6
   NLIST
   NL_CUTOFF_AB=1.0
   NL_CUTOFF_AC=1.0
   NL_STRIDE=500
   NESTED
   COMPONENTS
...

#####################################################################
### Biases ##########################################################
#####################################################################

restr: RESTRAINT ARG=rmsd AT=0 KAPPA=20000

scaledcv: COMBINE ARG=cvop.tot,cvob.tot COEFFICIENTS=@replicas:{{0,0} {0.57735,0.57735} {0.816497,0.816497} {1,1}} PERIODIC=NO

bias: BIASVALUE ARG=scaledcv

#####################################################################
### Output ##########################################################
#####################################################################

PRINT ARG=rmsd,restr.bias STRIDE=5000 FILE=rmsd.COLVAR
PRINT ARG=(cvop\.nb-.*),(cvop\.nc-.*),(cvob\.nb-.*),(cvob\.nc-.*) STRIDE=5000 FILE=no.COLVAR
PRINT ARG=(cvop\.func-.*),(cvob\.func-.*),(cvop\.tot),(cvob\.tot),bias.bias STRIDE=5000 FILE=bias.COLVAR

